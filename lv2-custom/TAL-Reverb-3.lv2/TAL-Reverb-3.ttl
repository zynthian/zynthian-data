@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pp:   <http://lv2plug.in/ns/ext/port-props#> .
@prefix plug: <urn:juce:TalReverb3> .


<urn:juce:TalReverb3>
    a lv2:ReverbPlugin, lv2:Plugin ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ,
                        <http://lv2plug.in/ns/ext/urid#map> ;
    lv2:extensionData <http://lv2plug.in/ns/ext/options#interface> ,
                      <http://lv2plug.in/ns/ext/state#interface> ,
                      <http://kxstudio.sf.net/ns/lv2ext/programs#Interface> ;

    lv2:microVersion 1 ;
    lv2:minorVersion 2 ;

    ui:ui <urn:juce:TalReverb3#ExternalUI> ,
          <urn:juce:TalReverb3#ParentUI> ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_freewheel" ;
        lv2:name "Freewheel" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:designation lv2:freeWheeling ;
        lv2:portProperty lv2:toggled, pp:notOnGUI ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio Input 2" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "unused" ;
        lv2:name "-" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G4_UNUSED ;
	    lv2:displayPriority 0 ;
        lv2:portProperty pp:notOnGUI ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "dry" ;
        lv2:name "Dry" ;
        lv2:default 0.500000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G1_SETUP ;
	    lv2:displayPriority 1 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "wet" ;
        lv2:name "Wet" ;
        lv2:default 0.266000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G1_SETUP ;
	    lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "room_size" ;
        lv2:name "Room Size" ;
        lv2:default 0.340000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G2_REVERB ;
	    lv2:displayPriority 3 ;
] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "pre_delay" ;
        lv2:name "Pre Delay" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G2_REVERB ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "low_shelf_gain" ;
        lv2:name "Low Cut" ;
        lv2:default 0.756000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G3_SOUND ;
	    lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "high_shelf_gain" ;
        lv2:name "High Cut" ;
        lv2:default 0.248000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G3_SOUND ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "stereo" ;
        lv2:name "Stereo Width" ;
        lv2:default 1.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G2_REVERB ;
	    lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "stereo_input" ;
        lv2:name "Stereo Input Processing" ;
        lv2:default 1.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G1_SETUP ;
	    lv2:displayPriority 2 ;
        lv2:scalePoint [
            rdf:value 0.0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1.0 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ];
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "power" ;
        lv2:name "Power" ;
        lv2:default 1.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:G1_SETUP ;
	    lv2:displayPriority 3 ;
        lv2:scalePoint [
            rdf:value 0.0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1.0 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ];
    ] ;

    doap:name "Tal-Reverb-III" ;
    doap:maintainer [ foaf:name "TAL-Togu Audio Line" ] .

plug:G1_SETUP
    a pg:ControlGroup ;
    lv2:name "Setup" ;
    lv2:symbol "g1_setup" ;
    lv2:displayPriority 3 .

plug:G2_REVERB
    a pg:ControlGroup ;
    lv2:name "Reverb" ;
    lv2:symbol "g2_reverb" ;
    lv2:displayPriority 2 .

plug:G3_SOUND
    a pg:ControlGroup ;
    lv2:name "Sound" ;
    lv2:symbol "g3_sound" ;
    lv2:displayPriority 1 .

plug:G4_UNUSED
    a pg:ControlGroup ;
    lv2:name "Unused" ;
    lv2:symbol "g4_unused" ;
    lv2:displayPriority 0 .
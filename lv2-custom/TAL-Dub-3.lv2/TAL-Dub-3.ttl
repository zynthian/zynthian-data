@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pp:   <http://lv2plug.in/ns/ext/port-props#> .
@prefix plug: <urn:juce:TalDub3> .


<urn:juce:TalDub3>
    a lv2:DelayPlugin, lv2:Plugin ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ,
                        <http://lv2plug.in/ns/ext/urid#map> ;
    lv2:extensionData <http://lv2plug.in/ns/ext/options#interface> ,
                      <http://lv2plug.in/ns/ext/state#interface> ,
                      <http://kxstudio.sf.net/ns/lv2ext/programs#Interface> ;

    lv2:microVersion 1 ;
    lv2:minorVersion 2 ;

    ui:ui <urn:juce:TalDub3#ExternalUI> ,
          <urn:juce:TalDub3#ParentUI> ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ;
        lv2:index 0 ;
        lv2:symbol "lv2_events_in" ;
        lv2:name "Events Input" ;
        lv2:designation lv2:control ;
        lv2:portProperty lv2:connectionOptional ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_freewheel" ;
        lv2:name "Freewheel" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:designation lv2:freeWheeling ;
        lv2:portProperty lv2:toggled, pp:notOnGUI ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio Input 2" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 5 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "inputdrive" ;
        lv2:name "In Drive" ;
        lv2:default 0.408000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:MAIN ;
	    lv2:displayPriority 3 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "delaytime" ;
        lv2:name "Delay Time" ;
        lv2:default 0.239000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:DELAY ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "delaytimesync" ;
        lv2:name "Host Sync" ;
        lv2:default 0.473684 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:DELAY ;
        lv2:displayPriority 2 ;
        lv2:scalePoint [
            rdf:value 0.0 ;
            rdfs:label "Free" ;
            rdfs:comment "Free" ;
        ], [
            rdf:value 0.052631 ;
            rdfs:label "1/16" ;
            rdfs:comment "1/16" ;
        ], [
            rdf:value 0.105263 ;
            rdfs:label "1/8" ;
            rdfs:comment "1/8" ;
        ], [
            rdf:value 0.157895 ;
            rdfs:label "1/4" ;
            rdfs:comment "1/4" ;
        ], [
            rdf:value 0.211053 ;
            rdfs:label "1/2" ;
            rdfs:comment "1/2" ;
        ], [
            rdf:value 0.263158 ;
            rdfs:label "1/1" ;
            rdfs:comment "1/1" ;
        ], [
            rdf:value 0.315789 ;
            rdfs:label "2/1" ;
            rdfs:comment "2/1" ;
        ], [
            rdf:value 0.368421 ;
            rdfs:label "1/16." ;
            rdfs:comment "1/16." ;
        ], [
            rdf:value 0.421052 ;
            rdfs:label "1/8." ;
            rdfs:comment "1/8." ;
        ], [
            rdf:value 0.473684 ;
            rdfs:label "1/4." ;
            rdfs:comment "1/4." ;
        ], [
            rdf:value 0.526316 ;
            rdfs:label "1/2." ;
            rdfs:comment "1/2." ;
        ], [
            rdf:value 0.578947 ;
            rdfs:label "1/1." ;
            rdfs:comment "1/1." ;
        ], [
            rdf:value 0.631579 ;
            rdfs:label "2/1." ;
            rdfs:comment "2/1." ;
        ], [
            rdf:value 0.684211 ;
            rdfs:label "1/16T" ;
            rdfs:comment "1/16T" ;
        ], [
            rdf:value 0.736842 ;
            rdfs:label "1/8T" ;
            rdfs:comment "1/8T" ;
        ], [
            rdf:value 0.789474 ;
            rdfs:label "1/4T" ;
            rdfs:comment "1/4T" ;
        ], [
            rdf:value 0.842105 ;
            rdfs:label "1/2T" ;
            rdfs:comment "1/2T" ;
        ], [
            rdf:value 0.894736 ;
            rdfs:label "1/1T" ;
            rdfs:comment "1/1T" ;
        ], [
            rdf:value 0.947368 ;
            rdfs:label "2/1T" ;
            rdfs:comment "2/1T" ;
        ], [
            rdf:value 1.0 ;
            rdfs:label "-" ;
            rdfs:comment "-" ;
        ];
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "delaytwice_l" ;
        lv2:name "x2 Left" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:DELAY ;
        lv2:displayPriority 1 ;
        lv2:scalePoint [
            rdf:value 0.0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1.0 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ];
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "delaytwice_r" ;
        lv2:name "x2 Right" ;
        lv2:default 1.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:DELAY ;
        lv2:displayPriority 0 ;
        lv2:scalePoint [
            rdf:value 0.0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1.0 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ];
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 0.148000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:MAIN ;
        lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "highcut" ;
        lv2:name "High Cut" ;
        lv2:default 0.252000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:FILTER ;
	    lv2:displayPriority 3 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "cutoff" ;
        lv2:name "Low Cut" ;
        lv2:default 0.548000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:FILTER ;
	    lv2:displayPriority 2 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "resonance" ;
        lv2:name "Resonance" ;
        lv2:default 0.432000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:FILTER ;
	    lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "dry" ;
        lv2:name "Dry" ;
        lv2:default 0.500000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:MAIN ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "wet" ;
        lv2:name "Wet" ;
        lv2:default 0.440000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:MAIN ;
	    lv2:displayPriority 1 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "unused" ;
        lv2:name "-" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:OTHER ;
	    lv2:displayPriority 1 ;
        lv2:portProperty pp:notOnGUI ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "livemode" ;
        lv2:name "Live Mode" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:OTHER ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "lv2_port_14" ;
        lv2:name "-" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group plug:OTHER ;
	    lv2:displayPriority 2 ;
        lv2:portProperty pp:notOnGUI ;
    ] ;

    doap:name "Tal-Dub-3" ;
    doap:maintainer [ foaf:name "TAL-Togu Audio Line" ] .

plug:MAIN
    a pg:ControlGroup ;
    lv2:name "Main" ;
    lv2:symbol "main" ;
    lv2:displayPriority 3 .

plug:DELAY
    a pg:ControlGroup ;
    lv2:name "Delay" ;
    lv2:symbol "delay" ;
    lv2:displayPriority 2 .

plug:FILTER
    a pg:ControlGroup ;
    lv2:name "Filter" ;
    lv2:symbol "filter" ;
    lv2:displayPriority 1 .

plug:OTHER
    a pg:ControlGroup ;
    lv2:name "Other" ;
    lv2:symbol "other" ;
    lv2:displayPriority 0 .
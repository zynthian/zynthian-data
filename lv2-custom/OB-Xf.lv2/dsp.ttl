@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufs:  <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix plug:  <urn:org.surge-synth-team.OB-Xf-rework:> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

###############################################################################
# Master PARAMETERS 
###############################################################################

plug:Volume
    a lv2:Parameter ;
    rdfs:label "Volume" ;
    pg:group plug:paramgroup_Root ;
    lv2:displayPriority 1000 ;
    rdfs:range atom:Float ;
    lv2:default 0.8 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0 .

plug:Transpose
    a lv2:Parameter ;
    rdfs:label "Transpose Simitone" ;
    pg:group plug:paramgroup_Root ;
    lv2:displayPriority 999 ;
    rdfs:range atom:Int ;
    lv2:default 0 ;
    lv2:minimum -24 ;
    lv2:maximum 24 .

plug:Tune
    a lv2:Parameter ;
    rdfs:label "Tune Cents" ;
    pg:group plug:paramgroup_Root ;
    lv2:displayPriority 998 ;
    rdfs:range atom:Float ;
    lv2:default 0.0 ;
    lv2:minimum -100 ;
    lv2:maximum 100 .

plug:Polyphony
    a lv2:Parameter ;
    rdfs:label "Polyphony" ;
    pg:group plug:paramgroup_Root ;
    lv2:displayPriority 997 ;
    rdfs:range atom:Int ;
    lv2:default 8 ;
    lv2:minimum 1 ;
    lv2:maximum 16 .

###############################################################################
# Global PARAMETERS 
###############################################################################

plug:HQMode
    a lv2:Parameter ;
    rdfs:label "HQ Mode" ;
    pg:group plug:paramgroup_Global_1 ;
    lv2:displayPriority 990 ;
    rdfs:range atom:Int ;
    lv2:default 0 ;
    lv2:minimum 0 ;
    lv2:maximum 1 ;
    lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ,
                   [ rdfs:label "On"  ; rdf:value 1 ] .

plug:UnisonVoices
    a lv2:Parameter ;
    rdfs:label "Unison Voices" ;
    pg:group plug:paramgroup_Global_1 ;
    lv2:displayPriority 989 ;
    rdfs:range atom:Int ;
    lv2:default 2 ;
    lv2:minimum 1 ;
    lv2:maximum 8 .

plug:Portamento
    a lv2:Parameter ;
    rdfs:label "Portamento" ;
    pg:group plug:paramgroup_Global_2 ;
    lv2:displayPriority 988 ;
    rdfs:range atom:Float ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0 .

plug:Unison
    a lv2:Parameter ;
    rdfs:label "Unison" ;
    pg:group plug:paramgroup_Global_1 ;
    lv2:displayPriority 987 ;
    rdfs:range atom:Int ;
    lv2:default 0 ;
    lv2:minimum 0 ;
    lv2:maximum 1 ;
    lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ,
                   [ rdfs:label "On"  ; rdf:value 1 ] .

plug:UnisonDetune
    a lv2:Parameter ;
    rdfs:label "Unison Detune" ;
    pg:group plug:paramgroup_Global_1 ;
    lv2:displayPriority 986 ;
    rdfs:range atom:Float ;
    lv2:default 0.25 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0 .

plug:EnvLegatoMode
    a lv2:Parameter ;
    rdfs:label "Env Legato Mode" ;
    pg:group plug:paramgroup_Global_2 ;
    lv2:displayPriority 985 ;
    rdfs:range atom:Int ;
    lv2:default 0 ;
    lv2:minimum 0 ;
    lv2:maximum 3 ;
    lv2:scalePoint [ rdfs:label "Both" ; rdf:value 0 ] ,
                   [ rdfs:label "Filter"  ; rdf:value 1 ] ,
                   [ rdfs:label "Amp"  ; rdf:value 2 ] ,
                   [ rdfs:label "Retrig"  ; rdf:value 3 ] .

plug:NotePriority
    a lv2:Parameter ;
    rdfs:label "Note Priority" ;
    pg:group plug:paramgroup_Global_2 ;
    lv2:displayPriority 984 ;
    rdfs:range atom:Int ;
    lv2:default 0 ;
    lv2:minimum 0 ;
    lv2:maximum 2 ;
    lv2:scalePoint [ rdfs:label "Last" ; rdf:value 0 ] ,
                   [ rdfs:label "Low"  ; rdf:value 1 ] ,
                   [ rdfs:label "High"  ; rdf:value 2 ] .


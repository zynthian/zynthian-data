<urn:org.surge-synth-team.OB-Xf-rework>
	ui:ui <urn:org.surge-synth-team.OB-Xf-rework:UI> ;
	a lv2:InstrumentPlugin ;
	doap:name "OB-Xf" ;
	doap:description "OB-Xf" ;
	lv2:minorVersion 9 ;
	lv2:microVersion 7 ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "Surge Synth Team" ;
		foaf:homepage <> ;
		foaf:mbox <> ;
	] ;
	doap:release [
		a doap:Version ;
		doap:revision "0.9.7" ;
	] ;
	lv2:optionalFeature
		lv2:hardRTCapable ;

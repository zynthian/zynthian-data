@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .
@prefix plug:  <urn:zamaudio:ZamEQ2> .

<urn:zamaudio:ZamEQ2>
    a lv2:EQPlugin, lv2:Plugin, doap:Project ;

    lv2:extensionData opts:interface ,
                      <http://kxstudio.sf.net/ns/lv2ext/programs#Interface> ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    ui:ui <urn:zamaudio:ZamEQ2#DPF_UI> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:name "Boost/Cut" ;
        lv2:symbol "boost1" ;
        lv2:default 0 ;
        lv2:minimum -20 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
        pg:group plug:G_MID1 ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:name "Bandwidth Narrow-Wide" ;
        lv2:symbol "bw1" ;
        lv2:default 1.5 ;
        lv2:minimum 0.699999988079 ;
        lv2:maximum 2.5 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
        pg:group plug:G_MID1 ;
        lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:name "Frequency" ;
        lv2:symbol "f1" ;
        lv2:default 1000 ;
        lv2:minimum 200 ;
        lv2:maximum 2500 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
        pg:group plug:G_MID1 ;
        lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "Boost/Cut" ;
        lv2:symbol "boost2" ;
        lv2:default 0 ;
        lv2:minimum -20 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
        pg:group plug:G_MID2 ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "Bandwidth Narrow-Wide" ;
        lv2:symbol "bw2" ;
        lv2:default 1.5 ;
        lv2:minimum 0.699999988079 ;
        lv2:maximum 2.5 ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
        pg:group plug:G_MID2 ;
        lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "Frequency" ;
        lv2:symbol "f2" ;
        lv2:default 3000 ;
        lv2:minimum 600 ;
        lv2:maximum 7000 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
        pg:group plug:G_MID2 ;
        lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "Lowshelf Boost/Cut" ;
        lv2:symbol "boostl" ;
        lv2:default 0 ;
        lv2:minimum -20 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
        pg:group plug:G_SHELF ;
        lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "Lowshelf Frequency" ;
        lv2:symbol "fl" ;
        lv2:default 250 ;
        lv2:minimum 40 ;
        lv2:maximum 600 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
        pg:group plug:G_SHELF ;
        lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "Highshelf Boost/Cut" ;
        lv2:symbol "boosth" ;
        lv2:default 0 ;
        lv2:minimum -20 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
        pg:group plug:G_SHELF ;
        lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "Highshelf Frequency" ;
        lv2:symbol "fh" ;
        lv2:default 8000 ;
        lv2:minimum 1500 ;
        lv2:maximum 22000 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
        pg:group plug:G_SHELF ;
        lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:name "Output Gain" ;
        lv2:symbol "outputgain" ;
        lv2:default 0 ;
        lv2:minimum -10 ;
        lv2:maximum 10 ;
        unit:unit unit:db ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:name "Input Gain" ;
        lv2:symbol "inputgain" ;
        lv2:default 0 ;
        lv2:minimum -10 ;
        lv2:maximum 10 ;
        pg:group plug:G_SETUP ;
        lv2:displayPriority 1 ;
    ] ;

    rdfs:comment "Two band parametric equaliser with high and low shelving circuits." ;

    mod:brand "ZamAudio" ;
    mod:label "ZamEQ2" ;

    doap:name "ZamEQ2" ;
    doap:license <http://spdx.org/licenses/GPL-2.0-or-later.html> ;

    doap:maintainer [
        foaf:name "Damien Zammit" ;
        foaf:homepage <http://www.zamaudio.com> ;
    ] ;

    lv2:microVersion 0 ;
    lv2:minorVersion 6 .

plug:G_SHELF
   a pg:ControlGroup ;
   lv2:name "Low/High Shelf" ;
   lv2:symbol "g_shelf" ;
   lv2:displayPriority 3 .

plug:G_MID1
   a pg:ControlGroup ;
   lv2:name "Low-Mid" ;
   lv2:symbol "g_mid1" ;
   lv2:displayPriority 2 .

plug:G_MID2
   a pg:ControlGroup ;
   lv2:name "High-Mid" ;
   lv2:symbol "g_mid2" ;
   lv2:displayPriority 1 .

plug:G_SETUP
   a pg:ControlGroup ;
   lv2:name "Gain" ;
   lv2:symbol "g_setup" ;
   lv2:displayPriority 0 .
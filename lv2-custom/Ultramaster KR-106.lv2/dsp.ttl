plug:output_group_1
	a pg:OutputGroup ;
	lv2:name "Output" ;
	lv2:symbol "output_group_1" .

<https://kayrock.org/kr106>
	ui:ui <https://kayrock.org/kr106:UI> ;
	a lv2:InstrumentPlugin ;
	doap:name "Ultramaster KR-106" ;
	doap:description "Ultramaster KR-106" ;
	lv2:minorVersion 1 ;
	lv2:microVersion 9 ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "Kayrock" ;
		foaf:homepage <> ;
		foaf:mbox <> ;
	] ;
	doap:release [
		a doap:Version ;
		doap:revision "2.1.9" ;
	] ;
	lv2:optionalFeature
		lv2:hardRTCapable ;
	lv2:extensionData
		state:interface ;
	lv2:requiredFeature
		urid:map ,
		opts:options ,
		bufs:boundedBlockLength ;
	pg:mainOutput plug:output_group_1 ;
	patch:writable
		plug:p0 ,
		plug:p1 ,
		plug:p42 ,
		plug:p2 ,
		plug:p3 ,
		plug:p4 ,
		plug:p5 ,
		plug:p6 ,
		plug:p7 ,
		plug:p8 ,

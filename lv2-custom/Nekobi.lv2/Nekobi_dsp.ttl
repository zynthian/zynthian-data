@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .
@prefix param:   <http://lv2plug.in/ns/ext/parameters#> .

<http://distrho.sf.net/plugins/Nekobi>
    a lv2:InstrumentPlugin, lv2:Plugin, doap:Project ;

    lv2:extensionData opts:interface ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    ui:ui <http://distrho.sf.net/plugins/Nekobi#DPF_UI> ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
        pg:group <http://distrho.sf.net/plugins/Nekobi#portGroup_dpf_mono> ;
        lv2:designation pg:center ;
    ] ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 1 ;
        lv2:name "Events Input" ;
        lv2:symbol "lv2_events_in" ;
        rsz:minimumSize 2048 ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:name "Waveform" ;
        lv2:symbol "waveform" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:enumeration ;
        lv2:scalePoint [
            rdfs:label  "Square" ;
            rdf:value 0 ;
        ] ,
        [
            rdfs:label  "Triangle" ;
            rdf:value 1 ;
        ] ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 70 ;
        ] ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:name "Tuning" ;
        lv2:symbol "tuning" ;
        lv2:default 0 ;
        lv2:minimum -12 ;
        lv2:maximum 12 ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 75 ;
        ] ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:name "Cutoff" ;
        lv2:symbol "cutoff" ;
        lv2:designation param:cutoffFrequency ;
        lv2:default 25 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 74 ;
        ] ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "VCF Resonance" ;
        lv2:symbol "resonance" ;
        lv2:designation param:resonance ;
        lv2:default 25 ;
        lv2:minimum 0 ;
        lv2:maximum 95 ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 71 ;
        ] ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "Env Mod" ;
        lv2:symbol "env_mod" ;
        lv2:default 50 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 1 ;
        ] ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "Decay" ;
        lv2:symbol "decay" ;
        lv2:default 75 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 72 ;
        ] ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "Accent" ;
        lv2:symbol "accent" ;
        lv2:default 25 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 76 ;
        ] ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "Volume" ;
        lv2:symbol "volume" ;
        lv2:default 75 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        midi:binding [
            a midi:Controller ;
            midi:controllerNumber 7 ;
        ] ;
        unit:unit unit:pc ;
    ] ;

    rdfs:comment "Simple single-oscillator synth based on the Roland TB-303." ;

    mod:brand "DISTRHO" ;
    mod:label "Nekobi" ;

    doap:name "Nekobi" ;
    doap:license <http://spdx.org/licenses/GPL-2.0-or-later.html> ;

    doap:maintainer [
        foaf:name "Sean Bolton, falkTX" ;
        foaf:homepage <https://github.com/DISTRHO/Nekobi> ;
    ] ;

    lv2:microVersion 0 ;
    lv2:minorVersion 3 .

<http://distrho.sf.net/plugins/Nekobi#portGroup_dpf_mono>
    a pg:OutputGroup , pg:MonoGroup ;
    lv2:name "Mono" ;
    lv2:symbol "dpf_mono" .

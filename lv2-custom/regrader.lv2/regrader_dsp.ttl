@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:  <http://lv2plug.in/ns/ext/resize-port#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix unit: <http://lv2plug.in/ns/extensions/units#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix plug: <https://github.com/linuxmao-org/regrader#> .

<https://github.com/linuxmao-org/regrader>
    a lv2:DelayPlugin, lv2:Plugin ;

    lv2:extensionData opts:interface ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    ui:ui <https://github.com/linuxmao-org/regrader#UI> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio Input 2" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
    ] ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 4 ;
        lv2:name "Events Input" ;
        lv2:symbol "lv2_events_in" ;
        rsz:minimumSize 2048 ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "Delay time" ;
        lv2:symbol "DelayTime" ;
        lv2:default 0.125000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
        unit:unit unit:s ;
        pg:group plug:G1_DELAY ;
	    lv2:displayPriority 3 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "Delay host sync" ;
        lv2:symbol "DelayHostSync" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
    	pg:group plug:G1_DELAY ;
	    lv2:displayPriority 0 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "Delay feedback" ;
        lv2:symbol "DelayFeedback" ;
        lv2:default 0.200000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
       	pg:group plug:G1_DELAY ;
	    lv2:displayPriority 2 ;

    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "Delay mix" ;
        lv2:symbol "DelayMix" ;
        lv2:default 0.500000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
    	pg:group plug:G1_DELAY ;
	    lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "Bit resolution" ;
        lv2:symbol "BitResolution" ;
        lv2:default 16.000000 ;
        lv2:minimum 1.000000 ;
        lv2:maximum 16.000000 ;
    	pg:group plug:G3_BITCRUSH ;
	    lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "Gravel postmix" ;
        lv2:symbol "BitResolutionChain" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
    	pg:group plug:G2_POSTMIX ;
	    lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "Bit LFO rate" ;
        lv2:symbol "LFOBitResolution" ;
        lv2:default 0.100000 ;
        lv2:minimum 0.100000 ;
        lv2:maximum 10.000000 ;
        unit:unit unit:hz ;
    	pg:group plug:G3_BITCRUSH ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:name "Bit LFO depth" ;
        lv2:symbol "LFOBitResolutionDepth" ;
        lv2:default 0.750000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
    	pg:group plug:G3_BITCRUSH ;
	    lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:name "Decimator resolution" ;
        lv2:symbol "Decimator" ;
        lv2:default 32 ;
        lv2:minimum 0 ;
        lv2:maximum 32 ;
        lv2:portProperty lv2:integer ;
    	pg:group plug:G4_DEGRADE ;
	    lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:name "Horror postmix" ;
        lv2:symbol "DecimatorChain" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
    	pg:group plug:G2_POSTMIX ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:name "Decimator rate" ;
        lv2:symbol "LFODecimator" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
    	pg:group plug:G4_DEGRADE ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:name "Filthr postmix" ;
        lv2:symbol "FilterChain" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
    	pg:group plug:G2_POSTMIX ;
	    lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:name "Filter cutoff" ;
        lv2:symbol "FilterCutoff" ;
        lv2:default 11025.000000 ;
        lv2:minimum 30.000000 ;
        lv2:maximum 22050.000000 ;
        unit:unit unit:hz ;
    	pg:group plug:G5_FILTER ;
	    lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:name "Filter resonance" ;
        lv2:symbol "FilterResonance" ;
        lv2:default 0.707107 ;
        lv2:minimum 0.100000 ;
        lv2:maximum 0.707107 ;
        unit:unit unit:db ;
    	pg:group plug:G5_FILTER ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:name "Filter LFO rate" ;
        lv2:symbol "LFOFilter" ;
        lv2:default 0.100000 ;
        lv2:minimum 0.100000 ;
        lv2:maximum 10.000000 ;
        unit:unit unit:hz ;
    	pg:group plug:G5_FILTER ;
	    lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:name "Filter LFO depth" ;
        lv2:symbol "LFOFilterDepth" ;
        lv2:default 0.500000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
    	pg:group plug:G5_FILTER ;
	    lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:name "Warble postmix" ;
        lv2:symbol "FlangerChain" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
    	pg:group plug:G2_POSTMIX ;
	    lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:name "Flanger LFO rate" ;
        lv2:symbol "FlangerRate" ;
        lv2:default 0.100000 ;
        lv2:minimum 0.100000 ;
        lv2:maximum 10.000000 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    	pg:group plug:G6_FLANGER ;
	    lv2:displayPriority 3 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:name "Flanger width" ;
        lv2:symbol "FlangerWidth" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
    	pg:group plug:G6_FLANGER ;
	    lv2:displayPriority 2 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:name """Flanger feedback""" ;
        lv2:symbol "FlangerFeedback" ;
        lv2:default 0.000000 ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
    	pg:group plug:G6_FLANGER ;
	    lv2:displayPriority 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:name "Flanger delay" ;
        lv2:symbol "FlangerDelay" ;
        lv2:default 0.100000 ;
        lv2:minimum 0.100000 ;
        lv2:maximum 1.000000 ;
    	pg:group plug:G6_FLANGER ;
	    lv2:displayPriority 0 ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:name "Output Gain" ;
        lv2:symbol "VuPPM" ;
        lv2:minimum 0.000000 ;
        lv2:maximum 1.000000 ;
    ] ;

    rdfs:comment """A delay effect where the repeats degrade in resolution""" ;

    mod:brand "Igorski" ;
    mod:label "Regrader" ;

    doap:name """Regrader""" ;
    doap:license <https://spdx.org/licenses/MIT> ;

    doap:maintainer [
        foaf:name """Igorski""" ;
        foaf:homepage <https://www.igorski.nl/download/regrader--degenerative-delay-processor> ;
    ] ;

    lv2:microVersion 1 ;
    lv2:minorVersion 0 .


plug:G1_DELAY
    a pg:InputGroup ;
    lv2:name "Echoes" ;
    lv2:symbol "g1_delay" ;
    lv2:displayPriority 6 .

plug:G3_BITCRUSH
    a pg:InputGroup ;
    lv2:name "Gravel" ;
    lv2:symbol "g3_bitcrush" ;
    lv2:displayPriority 5 .


plug:G4_DEGRADE
    a pg:InputGroup ;
    lv2:name "Horror" ;
    lv2:symbol "g4_degrade" ;
    lv2:displayPriority 4 .

plug:G5_FILTER
    a pg:InputGroup ;
    lv2:name "Filthr" ;
    lv2:symbol "g5_filter" ;
    lv2:displayPriority 3 .

plug:G6_FLANGER
    a pg:InputGroup ;
    lv2:name "Warble" ;
    lv2:symbol "g6_flanger" ;
    lv2:displayPriority 2 .

plug:G2_POSTMIX
    a pg:InputGroup ;
    lv2:name "Post Mix" ;
    lv2:symbol "g2_postmix" ;
    lv2:displayPriority 1 .

	pg:group plug:EARLY_DELAY ;
	lv2:displayPriority 1 ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:TapDecay
	a lv2:Parameter ;
	rdfs:label "Decay" ;
	pg:group plug:EARLY_DELAY ;
	lv2:displayPriority 0 ;

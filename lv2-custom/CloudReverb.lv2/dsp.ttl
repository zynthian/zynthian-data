plug:EARLY_DELAY
	a pg:ControlGroup ;
	lv2:name "Early Tap Delay" ;
	lv2:symbol "early_delay" ;
	lv2:displayPriority 9 .
plug:EARLY_DIFFUSION
	a pg:ControlGroup ;
	lv2:name "Early Diffusion" ;
	lv2:symbol "early_diffusion" ;
	lv2:displayPriority 8 .
plug:LATE_DELAY
	a pg:ControlGroup ;
	lv2:name "Late Delay" ;
	lv2:symbol "late_delay" ;
	lv2:displayPriority 7 .
plug:LATE_DIFFUSION
	a pg:ControlGroup ;
	lv2:name "Late Diffusion" ;
	lv2:symbol "late_diffusion" ;
	lv2:displayPriority 6 .
plug:EQ
	a pg:ControlGroup ;
	lv2:name "EQ" ;
	lv2:symbol "eq" ;
	lv2:displayPriority 5 .
plug:INPUT_MAIN
	a pg:ControlGroup ;
	lv2:name "Input Main" ;
	lv2:symbol "input_main" ;
	lv2:displayPriority 4 .
plug:INPUT_FILTER
	a pg:ControlGroup ;
	lv2:name "Input Filter" ;
	lv2:symbol "input_filter" ;
	lv2:displayPriority 3 .
plug:ROUTING
	a pg:ControlGroup ;
	lv2:name "Routing" ;
	lv2:symbol "routing" ;
	lv2:displayPriority 2 .
plug:MIXER
	a pg:ControlGroup ;
	lv2:name "Mixer" ;
	lv2:symbol "mixer" ;
	lv2:displayPriority 1 .
plug:SETUP
	a pg:ControlGroup ;
	lv2:name "Setup" ;
	lv2:symbol "setup" ;
	lv2:displayPriority 0 .

plug:input_group_1
	a pg:InputGroup ;
	lv2:name "Input" ;
	lv2:symbol "input_group_1" .

plug:output_group_1
	a pg:OutputGroup ;
	lv2:name "Output" ;
	lv2:symbol "output_group_1" .

<http://github.com/xunil-cloud/CloudReverb>
	ui:ui <http://github.com/xunil-cloud/CloudReverb:UI> ;
	a lv2:ReverbPlugin, lv2:Plugin ;
	doap:name "CloudReverb" ;
	doap:description "Algorithmic reverb. The algorithm is borrowed from CloudSeed VST by Valdemar Erlingsson." ;
	lv2:minorVersion 0 ;
	lv2:microVersion 3 ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "BensonC" ;
		foaf:homepage <> ;
		foaf:mbox <> ;
	] ;
	doap:release [
		a doap:Version ;
		doap:revision "0.3" ;
	] ;
	lv2:optionalFeature
		lv2:hardRTCapable ;
	lv2:extensionData
		state:interface ;
	lv2:requiredFeature
		urid:map ,
		opts:options ,
		bufs:boundedBlockLength ;
	pg:mainInput plug:input_group_1 ;
	pg:mainOutput plug:output_group_1 ;
	patch:writable
		plug:InputMix ,
		plug:PreDelay ,
		plug:HighPass ,
		plug:LowPass ,
		plug:TapCount ,
		plug:TapLength ,
		plug:TapGain ,
		plug:TapDecay ,
		plug:DiffusionEnabled ,
		plug:DiffusionStages ,
		plug:DiffusionDelay ,
		plug:DiffusionFeedback ,
		plug:LineCount ,
		plug:LineDelay ,
		plug:LineDecay ,
		plug:LateDiffusionEnabled ,
		plug:LateDiffusionStages ,
		plug:LateDiffusionDelay ,
		plug:LateDiffusionFeedback ,
		plug:PostLowShelfGain ,
		plug:PostLowShelfFrequency ,
		plug:PostHighShelfGain ,
		plug:PostHighShelfFrequency ,
		plug:PostCutoffFrequency ,
		plug:EarlyDiffusionModAmount ,
		plug:EarlyDiffusionModRate ,
		plug:LineModAmount ,
		plug:LineModRate ,
		plug:LateDiffusionModAmount ,
		plug:LateDiffusionModRate ,
		plug:TapSeed ,
		plug:DiffusionSeed ,
		plug:DelaySeed ,
		plug:PostDiffusionSeed ,
		plug:CrossSeed ,
		plug:DryOut ,
		plug:PredelayOut ,
		plug:EarlyOut ,
		plug:MainOut ,
		plug:HiPassEnabled ,
		plug:LowPassEnabled ,
		plug:LowShelfEnabled ,
		plug:HighShelfEnabled ,
		plug:CutoffEnabled ,
		plug:LateStageTap ,
		plug:Interpolation ;
	patch:readable
		plug:InputMix ,
		plug:PreDelay ,
		plug:HighPass ,
		plug:LowPass ,
		plug:TapCount ,
		plug:TapLength ,
		plug:TapGain ,
		plug:TapDecay ,
		plug:DiffusionEnabled ,
		plug:DiffusionStages ,
		plug:DiffusionDelay ,
		plug:DiffusionFeedback ,
		plug:LineCount ,
		plug:LineDelay ,
		plug:LineDecay ,
		plug:LateDiffusionEnabled ,
		plug:LateDiffusionStages ,
		plug:LateDiffusionDelay ,
		plug:LateDiffusionFeedback ,
		plug:PostLowShelfGain ,
		plug:PostLowShelfFrequency ,
		plug:PostHighShelfGain ,
		plug:PostHighShelfFrequency ,
		plug:PostCutoffFrequency ,
		plug:EarlyDiffusionModAmount ,
		plug:EarlyDiffusionModRate ,
		plug:LineModAmount ,
		plug:LineModRate ,
		plug:LateDiffusionModAmount ,
		plug:LateDiffusionModRate ,
		plug:TapSeed ,
		plug:DiffusionSeed ,
		plug:DelaySeed ,
		plug:PostDiffusionSeed ,
		plug:CrossSeed ,
		plug:DryOut ,
		plug:PredelayOut ,
		plug:EarlyOut ,
		plug:MainOut ,
		plug:HiPassEnabled ,
		plug:LowPassEnabled ,
		plug:LowShelfEnabled ,
		plug:HighShelfEnabled ,
		plug:CutoffEnabled ,
		plug:LateStageTap ,
		plug:Interpolation ;
	lv2:port [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 0 ;
		lv2:symbol "audio_in_1" ;
		lv2:name "Audio In 1" ;
		pg:group plug:input_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#left> ;
	] , [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "audio_in_2" ;
		lv2:name "Audio In 2" ;
		pg:group plug:input_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#right> ;
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 2 ;
		lv2:symbol "audio_out_1" ;
		lv2:name "Audio Out 1" ;
		pg:group plug:output_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#left> ;
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 3 ;
		lv2:symbol "audio_out_2" ;
		lv2:name "Audio Out 2" ;
		pg:group plug:output_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#right> ;
	] , [
		a lv2:InputPort , atom:AtomPort ;
		rsz:minimumSize 11504 ;
		atom:bufferType atom:Sequence ;
		atom:supports
			patch:Message ,
			time:Position ;
		lv2:designation lv2:control ;
		lv2:index 4 ;
		lv2:symbol "in" ;
		lv2:name "In" ;
	] , [
		a lv2:OutputPort , atom:AtomPort ;
		rsz:minimumSize 11504 ;
		atom:bufferType atom:Sequence ;
		atom:supports
			patch:Message ;
		lv2:designation lv2:control ;
		lv2:index 5 ;
		lv2:symbol "out" ;
		lv2:name "Out" ;
	] , [

plug:InputMix
	a lv2:Parameter ;
	rdfs:label "Blend" ;
	pg:group plug:INPUT_MAIN ;
	lv2:displayPriority 3 ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:PreDelay
	a lv2:Parameter ;
	rdfs:label "Pre Delay" ;
	pg:group plug:INPUT_MAIN ;
	lv2:displayPriority 2 ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1000 .

plug:HighPass
	a lv2:Parameter ;
	rdfs:label "Low Cut" ;
	pg:group plug:INPUT_FILTER ;
	lv2:displayPriority 3 ;
	rdfs:range atom:Float ;
	lv2:default 20 ;
	lv2:minimum 20 ;
	lv2:maximum 1000 .

plug:LowPass
	a lv2:Parameter ;
	rdfs:label "High Cut" ;
	pg:group plug:INPUT_FILTER ;
	lv2:displayPriority 2 ;
	rdfs:range atom:Float ;
	lv2:default 20000 ;
	lv2:minimum 400 ;
	lv2:maximum 20000 .

plug:TapCount
	a lv2:Parameter ;
	rdfs:label "Tap Count" ;
	pg:group plug:EARLY_DELAY ;
	lv2:displayPriority 4 ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 1 ;
	lv2:maximum 50 .

plug:TapLength
	a lv2:Parameter ;
	rdfs:label "Length" ;
	pg:group plug:EARLY_DELAY ;
	lv2:displayPriority 2 ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 500 .

plug:TapGain

plug:LateDiffusionEnabled
	a lv2:Parameter ;
	rdfs:label "Enabled" ;
	pg:group plug:LATE_DIFFUSION ;
	lv2:displayPriority 10 ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
